# Copy to .env.local for local development. Never commit real values.

# --- Frontend (Vite) ---
# Base URL of the Vercel deployment that serves /api/*.
# Leave empty to build the site without accounts, posts or suggested edits.
VITE_API_URL=https://your-project.vercel.app


# --- API (set these in the Vercel project, not here) ---
# Atlas connection string. Use a database user with readWrite on this database only.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=icaur

# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# Comma-separated origins allowed to call the API.
# ALLOWED_ORIGINS=https://khalidfathyfl.github.io

# --- Email through Brevo (optional; without these the site sends no email) ---
# Brevo → SMTP & API → API keys. Starts with xkeysib-.
# BREVO_API_KEY=
# A sender verified in Brevo → Senders, domains, IPs.
# EMAIL_FROM=khalidfathy077@gmail.com
# EMAIL_FROM_NAME=iCAUR V27
# Where replies go, if not to EMAIL_FROM.
# EMAIL_REPLY_TO=
# The public site; links and the photos in public/email/ are served from here.
# SITE_URL=https://khalidfathyfl.github.io/icaur-v27-guide/
# Random string. Vercel's daily cron sends it, and only it may run the queue.
# CRON_SECRET=
# Brevo free plan: 300 a day, of which new-post broadcasts may use 200.
# EMAIL_DAILY_LIMIT=300
# EMAIL_BROADCAST_DAILY_LIMIT=200
